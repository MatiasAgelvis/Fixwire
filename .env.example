# Database
DATABASE_URL=postgresql+asyncpg://fixwire:secret@localhost:5432/fixwire

# Redis
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000

# FIX Protocol
FIX_VERSION=FIX.4.4
FIX_SENDER_COMP_ID=MARKET01
FIX_TARGET_COMP_ID=CLIENT01
FIX_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=jsonr5
